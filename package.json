{
  "name": "@tanilo/x402-guard",
  "version": "0.1.0",
  "description": "A before-payment guard for x402 clients: checks the payment an agent is about to make against the customer's own supplied terms and cap, with Tanilo's published rules.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:x402": "node test/compat/run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@x402/core": ">=2.19.0 <3"
  },
  "keywords": [
    "x402",
    "payments",
    "agents",
    "guard",
    "tanilo"
  ],
  "homepage": "https://github.com/TKCollective/tanilo-x402-guard#readme",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Tanilo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TKCollective/tanilo-x402-guard.git"
  },
  "bugs": {
    "url": "https://github.com/TKCollective/tanilo-x402-guard/issues"
  }
}
